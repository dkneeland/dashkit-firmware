# DashKit project-configuration menu.
#
# CONFIG_DASHKIT_TESLA_BLE gates the Tesla BLE vehicle-command client. Phase 1
# is scan-only: the observer role plus main/tesla/tesla_ble_adapter (a passive
# listener that reports nearby Tesla advertisement names + MACs). Disabling the
# option removes the tesla/ modules and the BLE observer role from the build,
# so the stack stays exactly as a dashboard-only device expects it.
menu "DashKit"
    config DASHKIT_TESLA_BLE
        bool "Tesla BLE vehicle-command client"
        depends on BT_ENABLED && BT_NIMBLE_ENABLED
        default y
        help
            Adds the Tesla BLE observer (vehicle-command protocol). Phase 1:
            scan-only listener that reports nearby Tesla advertisement names
            and MACs. Disabling removes the tesla/ modules and the observer
            role from the build.
endmenu